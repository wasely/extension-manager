{
  "name": "extension-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Developer control center for locally loaded Chrome extensions.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "corepack pnpm --filter @extension-manager/manager-extension build",
    "dev": "corepack pnpm --filter @extension-manager/manager-extension dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "test": "corepack pnpm --filter @extension-manager/manager-extension test",
    "typecheck": "corepack pnpm --filter @extension-manager/manager-extension typecheck",
    "validate": "corepack pnpm format && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
